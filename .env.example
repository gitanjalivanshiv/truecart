# TrueCart environment. Copy to .env and fill in. Never commit .env.
# Everything runs against PayPal SANDBOX. The server refuses to boot with any other PayPal host.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from `npm run spike:webhook -- create --url ...` or the developer dashboard
PAYPAL_WEBHOOK_ID=
# Must be https://api-m.sandbox.paypal.com (default when blank)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Anthropic (Claude tool-use agent)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Channel3 product discovery (channel3.ai)
CHANNEL3_API_KEY=

# Optional: AG Studio licence (P2 dashboard)
AG_STUDIO_LICENSE_KEY=

# Public base URL of this app (Render URL in production; used for PayPal return URLs and webhooks)
APP_BASE_URL=http://localhost:3000

# Demo hygiene: hide brand names and retailer images (video/trademark safety)
MASK_BRANDS=true
# Replay recorded Channel3 fixtures instead of live calls
DEMO_MODE=false
