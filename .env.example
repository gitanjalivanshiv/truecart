# TrueCart environment. Copy to .env and fill in. Never commit .env.
# Everything runs against PayPal SANDBOX. The server refuses to boot with any other PayPal host.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from `npm run spike:webhook -- create --url ...` or the developer dashboard
PAYPAL_WEBHOOK_ID=
# Must be https://api-m.sandbox.paypal.com (default when blank)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# AI model for the shopping agent (provider-neutral; Gemini adapter included)
# Free key: aistudio.google.com -> Get API key. Free-tier inputs may be used by Google to improve its products;
# TrueCart only sends sandbox shopping data.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Channel3 product discovery (channel3.ai)
CHANNEL3_API_KEY=

# Optional: AG Studio licence (P2 dashboard)
AG_STUDIO_LICENSE_KEY=

# Sandbox buyer wallet (Vault payment token from `npm run spike:vault`) offered to new demo workspaces.
# Server-only; never sent to the browser.
DEMO_WALLET_TOKEN=

# AGENT_MODE=replay serves recorded AI runs for the demo requests (deterministic; no model calls)
AGENT_MODE=live

# Max agent turns per day across all visitors (protects the free-tier model)
AGENT_DAILY_TURNS=300

# Public base URL of this app (used for PayPal return URLs). On Render, RENDER_EXTERNAL_URL is used if unset.
APP_BASE_URL=http://localhost:3000

# Demo hygiene: hide brand names and retailer images (video/trademark safety)
MASK_BRANDS=true
# Replay recorded Channel3 fixtures instead of live calls
DEMO_MODE=false
